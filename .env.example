# SecureShop Cafe — optional Gmail SMTP for registration confirmations and
# newsletter coupons. Copy to .env (gitignored) or export in your shell.
# App password: Google Account -> Security -> 2-Step Verification -> App passwords.
# Without these, messages are printed to the server terminal (dev outbox).
SECURESHOP_SMTP_HOST=smtp.gmail.com
SECURESHOP_SMTP_PORT=465
SECURESHOP_SMTP_USER=your.address@gmail.com
SECURESHOP_SMTP_PASS=your-16-char-app-password
# SECURESHOP_SMTP_FROM=optional-display-address@gmail.com  # defaults to SMTP_USER

# Other supported overrides:
# SECURESHOP_DB=/path/to/secureshop.db
# SECURESHOP_HOST=127.0.0.1
# SECURESHOP_PORT=8000
# SECURESHOP_RISK_GATE_ENFORCE=1
